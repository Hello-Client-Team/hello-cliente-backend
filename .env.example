NODE_ENV=development
PORT=3333
# Runtime: Supabase Session Pooler (5432) or direct connection. Use a restricted role.
DATABASE_URL=postgresql://hello_app.PROJECT_REF:ENCODED_PASSWORD@REGION.pooler.supabase.com:5432/postgres
# Migrations: direct or Session Pooler, with migration owner credentials; never transaction mode.
DIRECT_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@REGION.pooler.supabase.com:5432/postgres
DB_SSL=true
# Optional custom CA certificate path, never disable certificate verification.
DB_SSL_CA_FILE=
REDIS_URL=redis://localhost:6379
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS_BEFORE_STARTING
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3333
CORS_ORIGINS=http://localhost:3000
COOKIE_SAME_SITE=lax
# Set trusted proxy addresses/subnets only when behind a known proxy; blank trusts none.
TRUST_PROXY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
HEALTH_INTERVAL_HOURS=6
HEALTH_FAILURE_THRESHOLD=3
HEALTH_TIMEOUT_MS=8000
DB_POOL_MAX=5
