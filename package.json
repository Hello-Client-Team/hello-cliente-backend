{
  "name": "hello-cliente-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/workers/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker": "node dist/workers/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./tests/setup.ts --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "6.0.0",
    "bullmq": "6.3.4",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "ipaddr.js": "2.5.0",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "10.0.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prisma": "7.10.0",
    "swagger-ui-dist": "5.32.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.5.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
